name=duktape
version=2.7.0
release=1
summary="Duktape: an embeddable JavaScript engine (the rules of polkit)"
homepage=https://duktape.org/
license=(MIT)
category=platform
depends=(glibc)
build_type=custom
source=(https://github.com/svaarala/duktape/releases/download/v$version/duktape-$version.tar.xz)
sha256=(90f8d2fa8b5567c6899830ddef2c03f3c27960b11aca222fa17aa7ac613c2890)

do_build() {
	# fast integer arithmetic, as other distributions build it
	sed -i 's/^#define DUK_F_PACKED_TVAL_POSSIBLE$/&\n#define DUK_USE_FASTINT/' src/duk_config.h
	make -f Makefile.sharedlibrary INSTALL_PREFIX=/usr CC="$CC" CFLAGS="$CFLAGS -w"
}
do_install() { make -f Makefile.sharedlibrary INSTALL_PREFIX="$DESTDIR/usr" install; }
