name=cleanlinux-profiles
version=2026.11.5
release=1
summary="The hardware profiles of CleanLinux for burn: generic, native and the devices"
homepage=https://github.com/vovawees/CleanLinux/tree/main/profiles
license=(MIT)
category=core
build_type=custom
# profiles/ of the CleanLinux repository (tools/profiles-tarball.sh, release profiles-VERSION);
# burn reads them from /usr/share/burn/profiles, /etc/burn/profiles comes first
source=(https://github.com/vovawees/CleanLinux/releases/download/profiles-$version/cleanlinux-profiles-$version.tar.gz)
sha256=(f7c3d59039e471b0595ed80725356a16d00e8b66de6423e43179a3b9e11a2759)

do_build() { :; }
do_install() {
	install -d "$DESTDIR/usr/share/burn"
	cp -r profiles "$DESTDIR/usr/share/burn/"
	find "$DESTDIR/usr/share/burn/profiles" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
	install -Dm644 LICENSE "$DESTDIR/usr/share/licenses/$name/LICENSE"
}
