name=gawk
version=5.4.1
release=2
summary="GNU awk"
homepage=https://www.gnu.org/software/gawk/
license=(GPL-3.0-or-later)
category=core
depends=(glibc)
features=(+nls)
source=(gnu://gawk/gawk-$version.tar.xz)
sha256=(07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37)
# 5.4.1: an untyped array element used as a number printed "0" (libpng's options.awk broke)
patches=(gawk-elem-new-stfmt.patch)
configure_args=(--without-readline --without-mpfr)
configure_extra() { use_enable nls; }

do_prepare() {
	# do not build the "extras" (sample scripts installed into /etc/profile.d)
	sed -i 's/extras//' Makefile.in
}

do_install() {
	bt_install
	# awk -> gawk, without the versioned copy
	rm -f "$DESTDIR/usr/bin/gawk-$version"
	ln -sf gawk "$DESTDIR/usr/bin/awk"
}
