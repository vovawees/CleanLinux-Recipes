name=ca-certificates
version=2026.10.20
release=1
summary="Mozilla's trusted root certificates for TLS (the NSS bundle as extracted by curl.se)"
homepage=https://curl.se/docs/caextract.html
license=(MPL-2.0)
category=core
build_type=custom
source=(https://curl.se/ca/cacert-${version//./-}.pem)
sha256=(796f1389bfea13c0ed78f663b765baaff54a508e5483786bd6ece73c5e3e3cbe)

# one PEM bundle where every TLS client looks: OpenSSL (OPENSSLDIR/cert.pem), curl, git, Python
do_install() {
	install -Dm644 "$FILES/cacert-${version//./-}.pem" "$DESTDIR/etc/ssl/certs/ca-certificates.crt"
	ln -s certs/ca-certificates.crt "$DESTDIR/etc/ssl/cert.pem"
}
