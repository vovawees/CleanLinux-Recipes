name=cryptsetup
version=2.8.8
release=1
summary="cryptsetup: disk encryption with dm-crypt (LUKS2, LUKS1, BitLocker, VeraCrypt), veritysetup, integritysetup"
homepage=https://gitlab.com/cryptsetup/cryptsetup
license=(GPL-2.0-or-later LGPL-2.1-or-later)
category=core
# the LUKS2 metadata is JSON (json-c), the device-mapper through libdevmapper (lvm2), signatures and
# UUIDs through libblkid/libuuid (util-linux), the command line through popt; OpenSSL 3.5 is the
# crypto backend and gives Argon2 (the LUKS2 default PBKDF), so the internal Argon2 is not built
depends=(glibc util-linux openssl json-c popt lvm2)
build_type=autotools
source=(kernel://utils/cryptsetup/v${version%.*}/cryptsetup-$version.tar.xz)
sha256=(3acfa685f2dd7fcc832e0b77bc7093aa7da554a51ce8dafbb4138eaa854eee35)
# cleanlinux-install --encrypt and the initramfs of cleanlinux-boot (rd.luks.uuid=) use it; the
# lock directory /run/cryptsetup comes from tmpfiles.d (cleanlinux-boot tmpfiles). No SSH token
# plugin (libssh), no password quality checks, no SELinux; the man pages come with the tarball.
configure_args=(--disable-static --disable-asciidoc --disable-ssh-token --disable-selinux --disable-pwquality
	--with-crypto_backend=openssl --with-tmpfilesdir=/usr/lib/tmpfiles.d)
