name=python-jinja
version=3.1.6
release=1
summary="Jinja: the template engine that elogind's build renders its generated files with"
homepage=https://palletsprojects.com/p/jinja/
license=(BSD-3-Clause)
category=devel
depends=(python python-markupsafe)
makedepends=(python-flit-core python-installer)
build_type=custom
source=(https://files.pythonhosted.org/packages/source/j/jinja2/jinja2-$version.tar.gz)
sha256=(0137fb05990d35f1275a587e9aee6d56da821fc83491a0fb838183be43f66d6d)

# flit_core builds the wheel itself: python -m build stops at the pin flit_core<4 of the sdist
# (flit_core 4 builds it the same)
do_build() { python3 -m flit_core.wheel --outdir dist; }
do_install() { python3 -m installer --destdir="$DESTDIR" --prefix=/usr dist/*.whl; }
