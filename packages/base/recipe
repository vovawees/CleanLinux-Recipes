name=base
version=2026.1
release=5
summary="Minimal CleanLinux userland (meta package)"
homepage=https://github.com/vovawees/CleanLinux-Recipes
license=(MIT)
category=meta
build_type=meta
# what boots and lets you in: init and devices, users and login (PAM, shadow), the tools of the
# root filesystems (btrfs, ext4, the vfat ESP), wired networking (DHCP); no kernel and no boot
# loader (profile, installer), no Wi-Fi daemon (iwd: the installer adds it where there is Wi-Fi)
depends=(filesystem glibc bash coreutils util-linux kmod dinit eudev sed grep gawk tar gzip xz zstd lz4 zlib-ng
	findutils diffutils ncurses readline libxcrypt linux-pam pambase shadow e2fsprogs btrfs-progs dosfstools
	iproute2 dhcpcd openresolv cleanlinux-boot burn)
