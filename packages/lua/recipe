name=lua
version=5.4.9
release=1
summary="Lua 5.4: the embeddable scripting language (WirePlumber's scripts), shared liblua"
homepage=https://www.lua.org/
license=(MIT)
category=platform
depends=(glibc readline)
build_type=custom
source=(https://www.lua.org/ftp/lua-$version.tar.gz)
sha256=(2335b6c582a52654f94612bf10d2f4672805d05329aa6568b1d8cd9e5c6fb8e6)

do_build() {
	local -a objs
	make -C src CC="$CC" AR="${AR:-ar} rcu" RANLIB="${RANLIB:-ranlib}" MYCFLAGS="$CFLAGS -fPIC" \
		MYLDFLAGS="$LDFLAGS" SYSCFLAGS="-DLUA_USE_LINUX -DLUA_USE_READLINE" SYSLIBS="-Wl,-E -ldl -lreadline" all
	# upstream builds only liblua.a: the shared library is made from the same objects
	mapfile -t objs < <("${AR:-ar}" t src/liblua.a)
	# shellcheck disable=SC2086 # the flags are word lists
	(cd src && "$CC" $CFLAGS $LDFLAGS -shared -Wl,-soname,liblua.so.5.4 -o liblua.so.$version "${objs[@]}" -lm -ldl)
}
do_install() {
	make INSTALL_TOP="$DESTDIR/usr" INSTALL_MAN="$DESTDIR/usr/share/man/man1" install
	rm -f "$DESTDIR/usr/lib/liblua.a"
	install -m755 "src/liblua.so.$version" "$DESTDIR/usr/lib/"
	ln -s "liblua.so.$version" "$DESTDIR/usr/lib/liblua.so.5.4"
	ln -s "liblua.so.$version" "$DESTDIR/usr/lib/liblua.so"
	install -d "$DESTDIR/usr/lib/pkgconfig"
	printf '%s\n' 'prefix=/usr' 'includedir=${prefix}/include' 'libdir=${prefix}/lib' '' 'Name: Lua' \
		'Description: An extensible extension language' "Version: $version" 'Libs: -L${libdir} -llua -lm -ldl' \
		'Cflags: -I${includedir}' >"$DESTDIR/usr/lib/pkgconfig/lua54.pc"
	ln -s lua54.pc "$DESTDIR/usr/lib/pkgconfig/lua.pc"
	ln -s lua54.pc "$DESTDIR/usr/lib/pkgconfig/lua5.4.pc"
	ln -s lua54.pc "$DESTDIR/usr/lib/pkgconfig/lua-5.4.pc"
	rmdir "$DESTDIR/usr/lib/lua/5.4" "$DESTDIR/usr/lib/lua" "$DESTDIR/usr/share/lua/5.4" "$DESTDIR/usr/share/lua" 2>/dev/null || true
}
