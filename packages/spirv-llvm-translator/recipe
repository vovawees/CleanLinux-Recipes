name=spirv-llvm-translator
version=23.1.3
release=1
summary="SPIRV-LLVM-Translator: LLVM IR to SPIR-V and back (LLVMSPIRVLib, llvm-spirv) for the OpenCL C kernels of Mesa"
homepage=https://github.com/KhronosGroup/SPIRV-LLVM-Translator
license=('Apache-2.0 WITH LLVM-exception')
category=devel
# the major and minor versions follow LLVM
depends=(glibc gcc-libs llvm spirv-tools)
makedepends=(cmake ninja spirv-headers)
build_type=cmake
source=(spirv-llvm-translator-$version.tar.gz::https://github.com/KhronosGroup/SPIRV-LLVM-Translator/archive/refs/tags/v$version.tar.gz)
sha256=(9ed57de3f31c575c836bef8f05ce5dfa98a8d80e64d948a02aac83c2e124f842)
cmake_args=(-DBUILD_SHARED_LIBS=ON -DLLVM_SPIRV_INCLUDE_TESTS=OFF -DLLVM_SPIRV_ENABLE_LIBSPIRV_DIS=ON)
# the headers of spirv-headers instead of a download at configure time
cmake_extra() { echo "-DLLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=${SYSROOT:-}/usr"; }
