# the logind API (sessions, seats, suspend, the power key and the lid) for spins that need it
# (dinitctl enable elogind); before the logins, so that pam_elogind registers every session
type = process
command = /usr/lib/elogind/elogind
restart = true
smooth-recovery = true
log-type = buffer
depends-on: dbus
before: login
