name=hardware
version=1
release=3
summary="The hardware profile of the device: its quirks (udev rules, hwdb, modprobe.d, sysctl.d), boot modules, kernel command line and boot loader"
homepage=https://github.com/vovawees/CleanLinux/tree/main/profiles
license=(MIT)
category=drivers
build_type=custom
source=(60-ioschedulers.rules)
sha256=(7e03b3241035d202dac8210034283af83e5055e8837476e9c710fcdb6b0a73f8)
# for every device: the I/O scheduler of each drive by its kind. From the profile of
# /etc/burn/burn.conf: QUIRKS, a directory laid out like /usr/lib (udev/rules.d, udev/hwdb.d,
# modprobe.d, sysctl.d, tmpfiles.d, cleanlinux/boot.d, cleanlinux/initramfs.d, ...; libinput/
# goes to /usr/share/libinput, where libinput reads its quirks), MODULES, loaded at every boot,
# KERNEL_CMDLINE (kernel/cmdline.d), BOOTLOADER and DEVICE_TREE (cleanlinux/boot.d, read by
# cleanlinux-boot kernel sync). burn rebuilds the package whenever they change.

do_build() { :; }
do_install() {
	local d=$DESTDIR/usr/lib m
	install -Dm644 "$FILES/60-ioschedulers.rules" "$d/udev/rules.d/60-ioschedulers.rules"
	if [[ -n ${QUIRKS:-} ]]; then
		[[ -d $QUIRKS ]] || die "QUIRKS=$QUIRKS: no such directory"
		mkdir -p "$d"
		cp -R --no-preserve=ownership "$QUIRKS"/. "$d/"
		if [[ -d $d/libinput ]]; then
			mkdir -p "$DESTDIR/usr/share" && mv "$d/libinput" "$DESTDIR/usr/share/libinput"
		fi
		find "$DESTDIR/usr" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
	fi
	if [[ -n ${MODULES:-} ]]; then
		install -d "$d/modules-load.d"
		{
			echo "# the modules of the profile $PROFILE, loaded at boot"
			for m in $MODULES; do echo "$m"; done
		} >"$d/modules-load.d/hardware.conf"
	fi
	if [[ -n ${KERNEL_CMDLINE:-} ]]; then
		install -d "$d/kernel/cmdline.d"
		printf '# the kernel parameters of the profile %s\n%s\n' "$PROFILE" "$KERNEL_CMDLINE" \
			>"$d/kernel/cmdline.d/50-profile.conf"
	fi
	if [[ -n ${BOOTLOADER:-}${DEVICE_TREE:-} ]]; then
		install -d "$d/cleanlinux/boot.d"
		{
			echo "# the boot loader of the profile $PROFILE (settings of your own: /etc/cleanlinux/boot.d)"
			if [[ -n ${BOOTLOADER:-} ]]; then echo "loader=$BOOTLOADER"; fi
			if [[ -n ${DEVICE_TREE:-} ]]; then echo "devicetree=$DEVICE_TREE"; fi
		} >"$d/cleanlinux/boot.d/50-profile.conf"
	fi
	install -d "$DESTDIR/usr/share/burn"
	printf 'profile=%s\nquirks=%s\nmodules=%s\nbootloader=%s\ndevice_tree=%s\n' "$PROFILE" "${QUIRKS:+yes}" \
		"${MODULES:-}" "${BOOTLOADER:-}" "${DEVICE_TREE:-}" >"$DESTDIR/usr/share/burn/hardware"
}
