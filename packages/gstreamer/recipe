name=gstreamer
version=1.28.8
release=1
summary="GStreamer: the multimedia framework core (pipelines, plugin registry, gst-launch-1.0, gst-inspect-1.0)"
homepage=https://gstreamer.freedesktop.org/
license=(LGPL-2.1-or-later)
category=platform
features=(+nls)
depends=(glibc glib)
makedepends=(bison flex)
build_type=meson
source=(https://gstreamer.freedesktop.org/src/gstreamer/gstreamer-$version.tar.xz)
sha256=(baa8e86985ad6417cc0ad6e7b79ff2884c6779c8b1c7a6240e7121822c86e524)
meson_args=(-Dgst_debug=true -Dgst_parse=true -Dregistry=true -Dtools=enabled -Dptp-helper=disabled -Dcheck=disabled
	-Dlibunwind=disabled -Dlibdw=disabled -Ddbghelp=disabled -Dbash-completion=disabled -Dcoretracers=disabled
	-Dexamples=disabled -Dtests=disabled -Dbenchmarks=disabled -Dintrospection=disabled -Ddoc=disabled
	-Dpackage-name=CleanLinux -Dpackage-origin=https://github.com/vovawees/CleanLinux)
meson_extra() { meson_feature nls; }
