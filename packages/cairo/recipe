name=cairo
version=1.18.6
release=2
summary="cairo: 2D vector graphics (image, PNG, PDF, PS, SVG surfaces; X11 and XCB ones with x11), drawn by pixman"
homepage=https://cairographics.org/
license=(LGPL-2.1-only MPL-1.1)
category=platform
# FreeType and Fontconfig for text; glib for cairo-gobject (GTK); no tests, no BFD symbol lookup.
# Feature x11: the Xlib and XCB surfaces (GTK on X11); a Wayland desktop draws into images.
features=(-x11)
depends=(glibc pixman fontconfig freetype libpng zlib-ng glib libx11:x11 libxext:x11 libxrender:x11 libxcb:x11)
build_type=meson
source=(https://cairographics.org/releases/cairo-$version.tar.xz)
sha256=(1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4)
meson_args=(-Dfontconfig=enabled -Dfreetype=enabled -Dpng=enabled -Dzlib=enabled -Dxlib-xcb=disabled
	-Dglib=enabled -Dtee=enabled -Ddwrite=disabled -Dquartz=disabled -Dtests=disabled -Dlzo=disabled
	-Dgtk2-utils=disabled -Dspectre=disabled -Dsymbol-lookup=disabled -Dgtk_doc=false)
meson_extra() {
	meson_feature x11 xlib
	meson_feature x11 xcb
}
