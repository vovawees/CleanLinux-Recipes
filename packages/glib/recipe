name=glib
version=2.90.1
release=1
summary="GLib: the core library of GNOME and many others (GObject, GIO, D-Bus bindings)"
homepage=https://gitlab.gnome.org/GNOME/glib
license=(LGPL-2.1-or-later)
category=platform
features=(+nls)
depends=(glibc pcre2 libffi zlib-ng util-linux)
build_type=meson
source=(https://download.gnome.org/sources/glib/${version%.*}/glib-$version.tar.xz)
sha256=(93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396)
# no GObject introspection (it needs GLib first; spins that use it rebuild with it), no tracing
meson_args=(-Dlibmount=enabled -Dxattr=true -Dselinux=disabled -Dman-pages=disabled -Ddtrace=disabled
	-Dsysprof=disabled -Ddocumentation=false -Dtests=false -Dinstalled_tests=false -Dlibelf=disabled
	-Dintrospection=disabled -Dglib_debug=disabled)
meson_extra() { meson_feature nls; }
