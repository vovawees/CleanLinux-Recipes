name=turnstile
version=0.1.11
release=1
summary="turnstile: a user service manager (dinit --user) and XDG_RUNTIME_DIR for every login, without systemd"
homepage=https://github.com/chimera-linux/turnstile
license=(BSD-2-Clause)
category=platform
# elogind (feature) manages /run/user itself; otherwise turnstile does. The user instance of dinit reads
# ~/.config/dinit.d, /etc/dinit.d/user and /usr/lib/dinit.d/user, and starts what /etc/dinit.d/user/boot.d
# links (the user services of spins) and ~/.config/dinit.d/boot.d
features=(-elogind)
depends=(glibc gcc-libs linux-pam dinit)
build_type=meson
source=(turnstile-$version.tar.gz::https://github.com/chimera-linux/turnstile/archive/refs/tags/v$version.tar.gz
	turnstiled.dinit)
sha256=(
	04904eff68a726bed281820b3497e018ede55a5d745f31ceb9a502f905d0ed56
	861a153db4db42a0f1f803b9c1b5299677e75ac293bf6a26dba0e2660e73dfaf
)
backup=(etc/turnstile/turnstiled.conf etc/turnstile/backend/dinit.conf)
meson_args=(-Ddinit=enabled -Drunit=disabled -Ddefault_backend=dinit -Dman=false -Dlibrary=disabled
	-Dpamdir=/usr/lib/pam.d -Dpam_moddir=/usr/lib/security)
meson_extra() { if use elogind; then echo -Dmanage_rundir=false; else echo -Dmanage_rundir=true; fi; }

post_install() {
	# the service of CleanLinux instead of the one for the targets of Chimera
	rm -f "$DESTDIR/etc/dinit.d/turnstiled"
	rmdir "$DESTDIR/etc/dinit.d" 2>/dev/null || true
	install -Dm644 "$FILES/turnstiled.dinit" "$DESTDIR/usr/lib/dinit.d/turnstiled"
	# the user services that the system enables for everyone: where burn spin links them
	sed -i 's|^system_boot_dir=.*|system_boot_dir="/etc/dinit.d/user/boot.d"|' \
		"$DESTDIR/etc/turnstile/backend/dinit.conf"
	install -dm755 "$DESTDIR/etc/dinit.d/user/boot.d"
}
