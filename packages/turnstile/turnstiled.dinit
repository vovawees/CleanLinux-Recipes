# turnstile: a user service manager (dinit --user) and XDG_RUNTIME_DIR for every login; the PAM
# module of system-login talks to it, so it runs before the logins
type = process
command = /usr/bin/turnstiled
restart = true
smooth-recovery = true
logfile = /var/log/turnstiled.log
depends-on: system
before: login
