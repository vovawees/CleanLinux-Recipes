name=bc
version=1.08.2
release=2
summary="GNU bc and dc: arbitrary precision calculators (the kernel build uses bc)"
homepage=https://www.gnu.org/software/bc/
license=(GPL-3.0-or-later)
category=devel
depends=(glibc readline ncurses)
build_type=autotools
source=(https://ftp.gnu.org/gnu/bc/bc-$version.tar.gz)
sha256=(ae470fec429775653e042015edc928d07c8c3b2fc59765172a330d3d87785f86)
configure_args=(--with-readline)
# configure makes doc/texi-ver.incl anew, so make remakes bc.info and dc.info (doc/Makefile.am
# sets MAKEINFO itself): no makeinfo on a device without texinfo, and burn drops info pages anyway
make_args=(MAKEINFO=true)
