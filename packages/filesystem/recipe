do_install() {
	local d f
	cd "$DESTDIR"
	for d in boot dev etc/ld.so.conf.d etc/profile.d home mnt opt proc root run srv sys tmp \
		usr/bin usr/include usr/lib usr/share/man usr/local/bin usr/local/lib usr/local/share \
		var/cache var/lib var/log var/spool var/tmp; do
		mkdir -p "$d"
	done
	# merged /usr: one bin and one lib directory, old paths are symlinks
	ln -s usr/bin bin
	ln -s usr/bin sbin
	ln -s usr/lib lib
	ln -s usr/lib lib64
	ln -s bin usr/sbin
	ln -s lib usr/lib64
	ln -s ../run var/run
	ln -s ../run/lock var/lock
	chmod 0750 root
	chmod 1777 tmp var/tmp
	for f in passwd group hosts fstab profile shells nsswitch.conf ld.so.conf issue; do
		install -m644 "$FILES/$f" "etc/$f"
	done
	install -Dm644 "$FILES/sysctl.conf" usr/lib/sysctl.d/50-cleanlinux.conf
	install -m644 "$FILES/os-release" usr/lib/os-release
	ln -s ../usr/lib/os-release etc/os-release
	# every account starts locked; set passwords after the first boot
	sed 's/^\([^:]*\):.*/\1:!*:20000::::::/' "$FILES/passwd" >etc/shadow
	# the group passwords of shadow (gpasswd, newgrp): none, members as in /etc/group
	sed 's/^\([^:]*\):[^:]*:[^:]*:\(.*\)$/\1:!::\2/' "$FILES/group" >etc/gshadow
	chmod 0600 etc/shadow etc/gshadow
}
