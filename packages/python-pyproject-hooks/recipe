name=python-pyproject-hooks
version=1.3.3
release=1
summary="pyproject_hooks: the PEP 517 hooks that front ends (build) call"
homepage=https://github.com/pypa/pyproject-hooks
license=(MIT)
category=devel
depends=(python)
makedepends=(python-flit-core python-installer)
build_type=custom
source=(https://files.pythonhosted.org/packages/source/p/pyproject_hooks/pyproject_hooks-$version.tar.gz)
sha256=(defda19b854fa0d3bd4f76ea4ddcba8abd7dcfcdd585a6690ade050744fc5f43)

# built before python-build exists: flit_core builds the wheel itself
do_build() { python3 -m flit_core.wheel --outdir dist; }
do_install() { python3 -m installer --destdir="$DESTDIR" --prefix=/usr dist/*.whl; }
