name=lvm2
version=2.03.43
release=1
summary="device-mapper of LVM2: libdevmapper, dmsetup and its udev rules (cryptsetup, dm-crypt)"
homepage=https://sourceware.org/lvm2/
license=(GPL-2.0-only LGPL-2.1-only)
category=core
depends=(glibc eudev bash)
build_type=autotools
source=(https://sourceware.org/pub/lvm2/LVM2.$version.tgz)
sha256=(d87ec0dac9061f1fa58ebced5c6b1360c87d4c5cd7b455dc0ebe1d3f036920d7)
# Only the device-mapper part for now (make device-mapper): the LVM tools need libaio and are not
# used by the installer yet. udev synchronisation with eudev, the 10-dm/13-dm-disk/95-dm-notify
# rules in /usr/lib/udev (they call /usr/bin/dmsetup); without a running udev (the initramfs)
# libdevmapper makes the /dev/mapper nodes itself. Runtime state in /run; no systemd, SELinux or
# readline. blkdeactivate is a bash script.
configure_args=(
	--enable-pkgconfig --enable-udev_sync --enable-udev_rules --with-udev-prefix=/usr
	--with-default-dm-run-dir=/run --with-default-run-dir=/run/lvm --with-default-pid-dir=/run
	--with-default-locking-dir=/run/lock/lvm --disable-readline --disable-selinux --without-systemd
	--disable-systemd-journal --disable-app-machineid --disable-sd-notify
	--with-thin=none --with-cache=none --with-vdo=none --with-writecache=none --with-integrity=none
)
# AC_FUNC_MALLOC cannot run its test when cross-compiling and would replace malloc
configure_extra() {
	if ((CROSS)); then printf '%s\n' ac_cv_func_malloc_0_nonnull=yes ac_cv_func_realloc_0_nonnull=yes; fi
}
# dmsetup (libdm/dm-tools) is built here: install_device-mapper would otherwise build it from two
# make processes at once (a race with -j: a broken dmsetup), and installs one file at a time
do_build() {
	make device-mapper
	make -C libdm dm-tools.device-mapper
}
do_install() { make -j1 DESTDIR="$DESTDIR" install_device-mapper; }
