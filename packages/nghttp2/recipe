name=nghttp2
version=1.71.0
release=1
summary="HTTP/2 library (libnghttp2): HTTP/2 of curl, git over HTTPS and the downloads of burn"
homepage=https://nghttp2.org/
license=(MIT)
category=core
# only the library: the servers, proxies and tools of nghttp2 need libev, c-ares and more
depends=(glibc)
build_type=autotools
source=(https://github.com/nghttp2/nghttp2/releases/download/v$version/nghttp2-$version.tar.xz)
sha256=(c0f55121d88650e4b9227aec28cebaf664d2417ca60fe70be0f8d38829f52116)
configure_args=(--enable-lib-only --disable-static --without-jemalloc --without-libxml2 --without-systemd)
