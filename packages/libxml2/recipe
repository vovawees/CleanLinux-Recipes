name=libxml2
version=2.15.4
release=1
summary="libxml2: the XML parser and toolkit of GNOME (xmllint)"
homepage=https://gitlab.gnome.org/GNOME/libxml2
license=(MIT)
category=platform
depends=(glibc zlib-ng)
build_type=meson
source=(https://download.gnome.org/sources/libxml2/${version%.*}/libxml2-$version.tar.xz)
sha256=(98087fd181d9070724f3fbc65c7377db03038eb92bd882374daff44940138821)
# no Python bindings, ICU or readline in xmllint; zlib for compressed documents
meson_args=(-Dpython=disabled -Dicu=disabled -Dreadline=disabled -Dhistory=disabled -Dzlib=enabled
	-Ddocs=disabled)
