name=cleanlinux-install
version=0.7.1
release=1
summary="The CleanLinux installer: cleanlinux-setup (screens) and cleanlinux-install (GPT, ESP, btrfs, a copy of the live medium with its drivers and desktop, the boot loader of the profile)"
homepage=https://github.com/vovawees/cleanlinux-install
license=(MIT)
category=core
# sfdisk and libblkid (util-linux), mkfs.vfat and mkfs.btrfs, useradd (shadow), yescrypt hashes
# (libxcrypt); the system is copied from the live medium (no package is built or downloaded), burn
# clones the packages with --clone; cleanlinux-boot puts the kernel and the loader in the ESP
# (systemd-boot, extlinux, rpi or android, from /usr/lib/cleanlinux/boot.d); cleanlinux-setup loads
# the keymaps and fonts of kbd (loadkeys, setfont) and lists the time zones of tzdata (zone.tab).
# No disk encryption: the base system has no cryptsetup
depends=(glibc util-linux libxcrypt dosfstools btrfs-progs shadow burn cleanlinux-boot kbd tzdata)
build_type=make
source=(https://github.com/vovawees/cleanlinux-install/releases/download/v$version/cleanlinux-install-$version.tar.gz)
sha256=(bc580b329a246803285bf9e011e65ca5a00c49156b1092660404839f59399dd9)
