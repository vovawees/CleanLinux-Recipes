name=burn
version=0.9.2
release=1
summary="The CleanLinux package manager: source based, rolling+++"
homepage=https://github.com/vovawees/burn
license=(MIT)
category=core
# bash runs the functions of recipes; libcurl downloads the sources inside burn (make CURL=1: HTTP/2,
# one connection per server); git syncs the recipe repositories and the spins; openssl makes and
# checks the signatures of packages (burn key, sign, verify, the binary cache)
depends=(glibc zstd bash curl git openssl)
build_type=make
make_args=(CURL=1)
source=(https://github.com/vovawees/burn/releases/download/v$version/burn-$version.tar.gz burn.sysusers)
sha256=(
	f0661ba0b83f2faaf44f19dd406a8646a47188cc16c6bb46a85b805dac259edd
	17f344844d9f6418d11c3c8ef3cfb03b673f42270b4918c32629e94b43844a3a
)

# root's builds run as the user burn, in their own network namespace (ISOLATE, BUILD_USER)
do_install() {
	bt_install
	install -Dm644 "$FILES/burn.sysusers" "$DESTDIR/usr/lib/sysusers.d/burn.conf"
}
