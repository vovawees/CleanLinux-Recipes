name=libcap
version=2.78
release=1
summary="libcap: POSIX capabilities library and tools (getcap, setcap, capsh)"
homepage=https://sites.google.com/site/fullycapable/
license=(BSD-3-Clause GPL-2.0-only)
category=platform
depends=(glibc)
build_type=custom
source=(kernel://libs/security/linux-privs/libcap2/libcap-$version.tar.xz)
sha256=(0d621e562fd932ccf67b9660fb018e468a683d7b827541df27813228c996bb11)

_make() {
	# CC on the command line: the Makefiles set it from CROSS_COMPILE; the helper programs that
	# generate headers run on the build machine (BUILD_CC); no Go bindings, no pam_cap
	make prefix=/usr lib=lib sbindir=bin GOLANG=no PAM_CAP=no RAISE_SETFCAP=no CC="$CC" BUILD_CC=gcc \
		AR="${AR:-ar}" RANLIB="${RANLIB:-ranlib}" "$@"
}
do_build() { _make; }
do_install() {
	_make DESTDIR="$DESTDIR" install
	rm -f "$DESTDIR"/usr/lib/*.a
}
