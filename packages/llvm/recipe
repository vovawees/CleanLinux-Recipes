name=llvm
version=23.1.5
release=1
summary="LLVM and clang: the compiler of llvmpipe and lavapipe and of the OpenCL C kernels of Mesa (Intel, Mali)"
homepage=https://llvm.org/
license=('Apache-2.0 WITH LLVM-exception')
category=devel
# Only Mesa needs it, and only where the GPU does (see the mesa recipe); the base compiler stays GCC.
# One shared libLLVM (llvm-libs, what llvmpipe links at run time) and libclang-cpp; the native target only:
# clang reaches SPIR-V through its SPIR target and SPIRV-LLVM-Translator, which need no backend
depends=(glibc gcc-libs zlib-ng zstd libffi ncurses)
makedepends=(cmake ninja python)
build_type=cmake
source=(https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz)
sha256=(fb50b1eac93ddeb3aa8dab4cfe324dff74f4a9c2bdee6160c9e36188f8d06a6e)
cmake_subdir=llvm
split=(llvm-libs)
summary_llvm_libs="The LLVM runtime library (libLLVM): llvmpipe and lavapipe of Mesa"
license_llvm_libs=('Apache-2.0 WITH LLVM-exception')
depends_llvm_libs=(glibc gcc-libs zlib-ng zstd libffi)
files_llvm_libs=('usr/lib/libLLVM.so.*' 'usr/lib/libLLVM-*.so')
cmake_args=(-DLLVM_ENABLE_PROJECTS=clang -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON -DCLANG_LINK_CLANG_DYLIB=ON
	-DLLVM_ENABLE_RTTI=ON -DLLVM_ENABLE_FFI=ON -DLLVM_ENABLE_ZLIB=FORCE_ON -DLLVM_ENABLE_ZSTD=FORCE_ON
	-DLLVM_ENABLE_LIBXML2=OFF -DLLVM_ENABLE_ASSERTIONS=OFF -DLLVM_INSTALL_UTILS=ON -DLLVM_INCLUDE_TESTS=OFF
	-DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_DOCS=OFF -DLLVM_ENABLE_BINDINGS=OFF
	-DCLANG_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_DOCS=OFF -DLLVM_PARALLEL_LINK_JOBS=1)
cmake_extra() {
	local target
	case $CARCH in
		x86_64) target=X86 ;;
		aarch64) target=AArch64 ;;
		*) die "llvm: no LLVM target for $CARCH" ;;
	esac
	printf '%s\n' "-DLLVM_TARGETS_TO_BUILD=$target" "-DLLVM_HOST_TRIPLE=$CHOST" "-DLLVM_DEFAULT_TARGET_TRIPLE=$CHOST"
}
