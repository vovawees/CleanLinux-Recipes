# Distribution PAM files live in /usr/lib/pam.d (Linux-PAM reads it after /etc/pam.d): updates
# replace them, a copy in /etc/pam.d overrides one for good.
do_install() {
	local f
	for f in system-auth system-login system-local-login system-remote-login system-services other; do
		install -Dm644 "$FILES/$f" "$DESTDIR/usr/lib/pam.d/$f"
	done
	install -dm755 "$DESTDIR/etc/pam.d"
}
