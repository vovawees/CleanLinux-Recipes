name=linux
version=7.3.1
release=8
summary="The Linux kernel and modules (CleanLinux defaults + profile GPU drivers)"
homepage=https://www.kernel.org/
license=(GPL-2.0-only)
category=kernel
build_type=custom
# the tools of the kernel build: bc, bison, flex, perl, openssl (module signing, certificates),
# libelf (objtool); pahole for the BTF of sched_ext
makedepends=(bc bison flex perl openssl elfutils dwarves:sched_ext)
features=(-sched_ext)
source=(kernel://kernel/v${version%%.*}.x/linux-$version.tar.xz cleanlinux.config x86.config)
sha256=(
	fa595aad93734f829c963c2a90ef7c3673224fd7fdae7b49406e397cde2de231
	ce571ee1e0a533f85d184008262bcf99659b281f42513f84c3acb927529ebaad
	848304723897fe231c5879ae0b63c189f37547872c024c8978af413809ffe8ca
)
options=(!lto !strip !hardening)

_kmake() {
	local -a cross=() repro=(KBUILD_BUILD_USER=burn KBUILD_BUILD_HOST=cleanlinux)
	if ((CROSS)); then cross=(CROSS_COMPILE="$CHOST-"); fi
	# reproducible: the build timestamp comes from the recipe (burn sets SOURCE_DATE_EPOCH)
	if [[ -n ${SOURCE_DATE_EPOCH:-} ]]; then repro+=(KBUILD_BUILD_TIMESTAMP="$(LC_ALL=C date -u -d "@$SOURCE_DATE_EPOCH")"); fi
	env -u CFLAGS -u CXXFLAGS -u LDFLAGS "${repro[@]}" make ARCH="$KARCH" HOSTCC=gcc "${cross[@]}" "$@"
}

do_configure() {
	local v
	# start from the profile's config (KERNEL_CONFIG=/path/to/config) or the arch defconfig, then
	# merge the CleanLinux defaults, the hardware of the arch, the GPU drivers of VIDEO_CARDS and
	# the profile's KERNEL_FRAGMENT
	if [[ -n $KERNEL_CONFIG ]]; then cp "$KERNEL_CONFIG" .config; else _kmake defconfig; fi
	cp "$FILES/cleanlinux.config" "$WORK/fragment.config"
	{
		# x86-64 PCs, laptops and handhelds: power, platform drivers, input, sensors, sound
		if [[ $KARCH == x86 ]]; then cat "$FILES/x86.config"; fi
		# sched_ext: BPF CPU schedulers (scx_lavd, scx_bpfland...); needs pahole on the build host
		if use sched_ext; then
			printf '%s\n' CONFIG_BPF=y CONFIG_BPF_SYSCALL=y CONFIG_BPF_JIT=y CONFIG_DEBUG_INFO=y \
				CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y CONFIG_DEBUG_INFO_BTF=y CONFIG_SCHED_CLASS_EXT=y
		fi
		for v in $VIDEO_CARDS; do
			case $v in
				amd) printf '%s\n' CONFIG_DRM_AMDGPU=m CONFIG_DRM_AMDGPU_CIK=y CONFIG_DRM_AMDGPU_SI=y CONFIG_DRM_AMD_DC=y ;;
				intel) printf '%s\n' CONFIG_DRM_I915=m CONFIG_DRM_XE=m ;;
				nouveau) printf '%s\n' CONFIG_DRM_NOUVEAU=m ;;
				freedreno) printf '%s\n' CONFIG_DRM_MSM=m ;;
				panfrost) printf '%s\n' CONFIG_DRM_PANFROST=m CONFIG_DRM_PANTHOR=m ;;
				v3d) printf '%s\n' CONFIG_DRM_V3D=m CONFIG_DRM_VC4=m ;;
				lima) printf '%s\n' CONFIG_DRM_LIMA=m ;;
				etnaviv) printf '%s\n' CONFIG_DRM_ETNAVIV=m ;;
				virgl) printf '%s\n' CONFIG_DRM_VIRTIO_GPU=m ;;
			esac
		done
		# the device's own options (KERNEL_FRAGMENT in its profile) come last and win
		if [[ -n ${KERNEL_FRAGMENT:-} ]]; then
			[[ -f $KERNEL_FRAGMENT ]] || die "KERNEL_FRAGMENT=$KERNEL_FRAGMENT: no such file"
			cat "$KERNEL_FRAGMENT"
		fi
	} >>"$WORK/fragment.config"
	scripts/kconfig/merge_config.sh -m .config "$WORK/fragment.config"
	_kmake olddefconfig
}

do_build() { _kmake all; }

do_install() {
	local kver image
	kver=$(_kmake -s kernelrelease)
	image=$(_kmake -s image_name)
	_kmake INSTALL_MOD_PATH="$DESTDIR/usr" INSTALL_MOD_STRIP=1 modules_install
	rm -f "$DESTDIR/usr/lib/modules/$kver/build" "$DESTDIR/usr/lib/modules/$kver/source"
	install -Dm644 "$image" "$DESTDIR/usr/lib/modules/$kver/vmlinuz"
	install -Dm644 .config "$DESTDIR/usr/lib/modules/$kver/config"
	# the exported symbols, for modules built outside this tree (nvidia)
	install -Dm644 Module.symvers "$DESTDIR/usr/lib/modules/$kver/Module.symvers"
	if [[ $KARCH == arm64 ]]; then _kmake INSTALL_DTBS_PATH="$DESTDIR/usr/lib/modules/$kver/dtbs" dtbs_install; fi
	if [[ -n $KERNEL_CMDLINE ]]; then printf '%s\n' "$KERNEL_CMDLINE" >"$DESTDIR/usr/lib/modules/$kver/cmdline"; fi
}
