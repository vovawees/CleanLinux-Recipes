# CleanLinux x86-64 hardware support, merged after cleanlinux.config: every PC, laptop and handheld
# the profiles cover, drivers as modules (udev loads them by modalias)
# the zstd kernel image, the serial console, the RTC
CONFIG_KERNEL_ZSTD=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
# AES-NI: dm-crypt (an encrypted root) and the rest of the kernel's AES at the speed of the CPU
CONFIG_CRYPTO_AES_NI_INTEL=y
# AMD: amd-pstate with EPP (active mode), s2idle (PMC), sensor fusion hub (SFH), the power
# framework (PMF, needs the PSP TEE), CPU temperatures
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
CONFIG_AMD_PMC=m
CONFIG_AMD_SFH_HID=m
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=m
CONFIG_CRYPTO_DEV_SP_PSP=y
CONFIG_TEE=m
CONFIG_AMDTEE=m
CONFIG_AMD_PMF=m
CONFIG_SENSORS_K10TEMP=m
# Intel: s2idle residency (PMC core), power/volume buttons and tablet mode (HID event, VBTN),
# RAPL power limits (powercap), CPU temperatures
CONFIG_INTEL_VSEC=m
CONFIG_INTEL_PMT_TELEMETRY=m
CONFIG_INTEL_PMC_CORE=m
CONFIG_INTEL_HID_EVENT=m
CONFIG_INTEL_VBTN=m
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_SENSORS_CORETEMP=m
# handheld controllers and platform drivers (ROG Ally, Legion Go, MSI Claw, AYANEO, OneXPlayer):
# buttons, fan and TDP controls through platform_profile and the firmware attributes class
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_ARMOURY=m
CONFIG_HID_ASUS=m
CONFIG_LENOVO_WMI_GAMEZONE=m
CONFIG_LENOVO_WMI_TUNING=m
CONFIG_HID_LENOVO_GO=m
CONFIG_HID_LENOVO_GO_S=m
CONFIG_HID_MSI=m
CONFIG_MSI_WMI_PLATFORM=m
CONFIG_AYANEO_EC=m
CONFIG_OXP_EC=m
# touchpads and touchscreens: I2C HID behind the Intel LPSS / AMD I2C controllers, whose
# interrupts come from the GPIO (pinctrl) drivers; HID multitouch, Goodix panels
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_COMMON_CLK=y
CONFIG_I2C_AMD_MP2=m
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
# screen rotation and ambient light: HID sensors (Intel ISH, AMD SFH) and the I2C IMUs of
# handhelds and tablets (BMI323: ROG Ally, Legion Go), exposed through IIO
CONFIG_IIO=m
CONFIG_HID_SENSOR_HUB=m
CONFIG_HID_SENSOR_IIO_COMMON=m
CONFIG_HID_SENSOR_ACCEL_3D=m
CONFIG_HID_SENSOR_GYRO_3D=m
CONFIG_HID_SENSOR_ALS=m
CONFIG_HID_SENSOR_DEVICE_ROTATION=m
CONFIG_INTEL_ISH_HID=m
CONFIG_BMI323_I2C=m
CONFIG_BMI160_I2C=m
CONFIG_BMI270_I2C=m
CONFIG_BMC150_ACCEL=m
CONFIG_KXCJK1013=m
CONFIG_MXC4005=m
# USB-C: power delivery and charger state (UCSI), USB4/Thunderbolt
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m
CONFIG_USB4=m
# sound: HD-audio with every codec family (Realtek, Conexant, Cirrus...), its speaker amplifiers
# (CS35L41/CS35L56, TAS2781: ROG Ally, Legion Go, many laptops) and HDMI/DP audio; the DSP audio
# of newer laptops and handhelds: Sound Open Firmware for Intel (Tiger Lake..Panther Lake,
# SoundWire) and AMD (Van Gogh = Steam Deck, Rembrandt, Phoenix/ACP 6.3, ACP 7.x), the AMD ACP
# drivers and DMIC machines. Firmware: sof-firmware, linux-firmware (cirrus/); UCM: alsa-ucm-conf
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_PATCH_LOADER=y
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_SENARYTECH=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_CMEDIA=m
CONFIG_SND_HDA_CODEC_SI3054=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L41_SPI=m
CONFIG_SND_HDA_SCODEC_CS35L56_I2C=m
CONFIG_SND_HDA_SCODEC_CS35L56_SPI=m
CONFIG_SND_HDA_SCODEC_TAS2781_I2C=m
CONFIG_SND_HDA_SCODEC_TAS2781_SPI=m
# the amplifiers are one ACPI device (CSC3551...) for two or four chips: serial-multi-instantiate
# makes their I2C/SPI devices; on AMD they sit on the SPI controller of the APU (Steam Deck LCD)
CONFIG_SERIAL_MULTI_INSTANTIATE=m
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_AMD=m
CONFIG_SPI_PXA2XX=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=m
CONFIG_SND_SOC_SOF_ALDERLAKE=m
CONFIG_SND_SOC_SOF_METEORLAKE=m
CONFIG_SND_SOC_SOF_LUNARLAKE=m
CONFIG_SND_SOC_SOF_PANTHERLAKE=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_INTEL=m
CONFIG_SOUNDWIRE_AMD=m
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=m
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=m
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=m
CONFIG_SND_SOC_INTEL_SOF_SSP_AMP_MACH=m
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=m
CONFIG_SND_SOC_SOF_AMD_RENOIR=m
CONFIG_SND_SOC_SOF_AMD_VANGOGH=m
CONFIG_SND_SOC_SOF_AMD_REMBRANDT=m
CONFIG_SND_SOC_SOF_AMD_ACP63=m
CONFIG_SND_SOC_SOF_AMD_ACP70=m
CONFIG_SND_SOC_AMD_ACP=m
CONFIG_SND_SOC_AMD_RENOIR=m
CONFIG_SND_SOC_AMD_RENOIR_MACH=m
CONFIG_SND_SOC_AMD_ACP5x=m
CONFIG_SND_SOC_AMD_VANGOGH_MACH=m
CONFIG_SND_SOC_AMD_ACP6x=m
CONFIG_SND_SOC_AMD_YC_MACH=m
CONFIG_SND_AMD_ACP_CONFIG=m
CONFIG_SND_SOC_AMD_ACP63_TOPLEVEL=m
CONFIG_SND_SOC_AMD_PS=m
CONFIG_SND_SOC_AMD_PS_MACH=m
CONFIG_SND_SOC_AMD_SOUNDWIRE=m
CONFIG_SND_SOC_AMD_ACP_COMMON=m
CONFIG_SND_SOC_AMD_ACP_PCI=m
CONFIG_SND_AMD_ASOC_REMBRANDT=m
CONFIG_SND_AMD_ASOC_ACP63=m
CONFIG_SND_AMD_ASOC_ACP70=m
CONFIG_SND_SOC_AMD_LEGACY_MACH=m
CONFIG_SND_SOC_AMD_SOF_MACH=m
CONFIG_SND_SOC_DMIC=m
