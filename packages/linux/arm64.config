# CleanLinux arm64, merged after cleanlinux.config: vmlinuz is an EFI program that decompresses
# itself (UEFI and systemd-boot start it, U-Boot through bootefi); U-Boot extlinux, the Raspberry Pi
# firmware and Android boot images take the plain Image installed next to it
CONFIG_EFI_ZBOOT=y
CONFIG_KERNEL_ZSTD=y
