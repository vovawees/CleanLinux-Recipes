# CleanLinux kernel defaults, merged on top of defconfig (or the profile's KERNEL_CONFIG)
CONFIG_LOCALVERSION="-cleanlinux"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# boot and devices without an initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# low latency on interactive devices, selectable at boot (preempt=full|lazy|voluntary|none)
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
# desktop responsiveness: tasks are grouped per session
CONFIG_SCHED_AUTOGROUP=y
# memory: zstd zswap (with its shrinker) and zram, multi-gen LRU, THP only when asked,
# pressure stall information for low-memory handling
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_PSI=y
# I/O: BFQ for slow flash (SD cards, eMMC), mq-deadline/none for NVMe
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
# network: BBR congestion control with the fq qdisc by default, WireGuard
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_WIREGUARD=m
# NT synchronization primitives for Wine (/dev/ntsync), as a module: whatever needs it
# loads it (for example, a spin ships a modules-load.d file)
CONFIG_NTSYNC=m
# storage: btrfs with zstd, small compressed modules (and kernel on x86, see the recipe)
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# CPU frequency/power for battery devices
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ENERGY_MODEL=y
# input and sound: built-in handheld controls, USB/Bluetooth gamepads, USB audio
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_HID_STEAM=m
CONFIG_HID_NINTENDO=m
# the DualShock/DualSense light bar is a multicolor LED
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_SND_USB_AUDIO=m
# containers and sandboxes (Flatpak, bubblewrap, podman, ...)
CONFIG_USER_NS=y
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# storage, partition tables and root filesystems built in: the kernel mounts root=PARTUUID=
# itself, no initramfs (NVMe, AHCI, virtio, USB storage, SD/eMMC; btrfs, ext4, vfat for the ESP)
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# LUKS (dm-crypt) for an encrypted root, opened by the cleanlinux-boot initramfs
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
# UEFI: the kernel is an EFI program itself (systemd-boot starts it), efivarfs for the loader
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
# the console on the firmware's framebuffer until the GPU driver takes over
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# the clock from the RTC at boot (cleanlinux-boot keeps it from going backwards)
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
# compressed firmware (linux-firmware ships .zst), entropy in virtual machines, zstd for zswap
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_CRYPTO_ZSTD=y
# Wi-Fi: iwd uses the kernel's crypto (AF_ALG hashes and ciphers, keyrings with DH and
# certificates); the common PCIe/USB adapters as modules (firmware from linux-firmware);
# mac80211_hwsim for testing in virtual machines
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_MAC80211_HWSIM=m
# Bluetooth (bluez): USB and UART controllers, HID and audio profiles need uhid
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=m
CONFIG_GPIOLIB=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_UHID=m
