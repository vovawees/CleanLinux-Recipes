# CleanLinux kernel defaults, merged on top of defconfig (or the profile's KERNEL_CONFIG)
CONFIG_LOCALVERSION="-cleanlinux"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# boot and devices without an initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# low latency for games and handhelds, selectable at boot (preempt=full|voluntary|none)
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
# memory: zstd zswap/zram, multi-gen LRU, THP only when asked
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=m
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# storage: btrfs with zstd, small compressed kernel and modules
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# CPU frequency/power for battery devices
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ENERGY_MODEL=y
# input, sound, controllers
CONFIG_INPUT_UINPUT=m
CONFIG_HID_STEAM=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_SND_USB_AUDIO=m
# containers and sandboxes (Flatpak, bubblewrap, Steam pressure-vessel)
CONFIG_USER_NS=y
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
