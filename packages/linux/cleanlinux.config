# CleanLinux kernel defaults, merged on top of defconfig (or the profile's KERNEL_CONFIG)
CONFIG_LOCALVERSION="-cleanlinux"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# boot and devices without an initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
# low latency for games and handhelds, selectable at boot (preempt=full|lazy|voluntary|none)
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
# desktop responsiveness: tasks are grouped per session
CONFIG_SCHED_AUTOGROUP=y
# memory: zstd zswap (with its shrinker) and zram, multi-gen LRU, THP only when asked,
# pressure stall information for low-memory handling
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_PSI=y
# I/O: BFQ for slow flash (SD cards, eMMC), mq-deadline/none for NVMe
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
# network: BBR congestion control with the fq qdisc by default, WireGuard
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_WIREGUARD=m
# Wine/Proton: NT synchronization primitives (/dev/ntsync)
CONFIG_NTSYNC=y
# storage: btrfs with zstd, small compressed modules (and kernel on x86, see the recipe)
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
# CPU frequency/power for battery devices
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ENERGY_MODEL=y
# input, sound, controllers
CONFIG_INPUT_UINPUT=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_HID_STEAM=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_SND_USB_AUDIO=m
# containers and sandboxes (Flatpak, bubblewrap, Steam pressure-vessel)
CONFIG_USER_NS=y
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
