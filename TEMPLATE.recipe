# packages/<name>/recipe - copy, fill in, then:
#   burn -R packages checksum --write <name>   (real sha256 from the downloaded files)
#   burn -R packages lint <name> && burn -R packages build <name>
name=example
version=1.2.3
release=1
summary="One line: what it is"
homepage=https://example.org/
license=(MIT)
category=core                       # core devel meta kernel firmware drivers platform (README)
depends=(glibc zlib-ng:zlib)        # "pkg:feature" = only when the feature is on
makedepends=(pkgconf)               # build-time only (skipped with --host-deps / cross builds)
features=(+zlib -doc)               # +on by default, -off by default
build_type=meson                    # autotools meson cmake make cargo python custom meta
source=(https://example.org/releases/example-$version.tar.xz)
sha256=(SKIP)                       # replaced by: burn checksum --write
patches=()                          # files in patches/ (or downloaded sources)
meson_args=(-Dtests=false)
meson_extra() {                     # one argument per line, may use features
	meson_feature zlib
}
# optional hooks, run inside the source directory:
#   do_prepare do_configure do_build do_check do_install post_install
# inside them: $SRC $BUILD $DESTDIR $FILES $CC $CFLAGS $CHOST $CARCH $CROSS $JOBS, bt_<phase>
